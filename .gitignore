# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets. .env.example carries the shape without the values.
.env

# Datasets and the built database. These stay off the repo for two reasons:
# size (the OpenFoodFacts export alone is 6 GB, and GitHub rejects anything
# over 100 MB), and licence — OpenFoodFacts is ODbL and is quarantined from
# every published surface of this project. Rebuild with the pipeline instead.
#
# The single exception is the deployable extract: site rows only, no
# OpenFoodFacts and no Wikipedia, 18 MB. Built by tools/export_site_db.py.
# Order matters here — the last matching rule wins.
data/*
!data/metadata/
data/metadata/*
!data/metadata/site.db
*.db-shm
*.db-wal

# Node
node_modules/

# Regenerated by tools/capture_pages.py
docs/screenshots/
docs/shots.json
docs/handover.html

# Superseded handover under the old brand name; kept locally, not in the repo.
docs/Calorie-Atlas-handover.pdf
